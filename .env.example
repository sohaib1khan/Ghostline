# App
APP_ENV=development                # development | production
APP_BASE_URL=http://localhost:8080
APP_SECRET_KEY=change-me           # generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
APP_ENCRYPTION_KEY=change-me       # generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_TTL_HOURS=168

# Database
POSTGRES_DB=ghostline
POSTGRES_USER=ghostline
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://ghostline:change-me@db:5432/ghostline

# Ports
WEB_PORT=8080

# Rate limits (requests per minute)
RATE_LIMIT_LOGIN=5
RATE_LIMIT_SIGNUP=3
RATE_LIMIT_DEMO_CHECK=30
RATE_LIMIT_AI=10

# Playground — ephemeral Docker workers (no file persistence)
PLAYGROUND_ENABLED=false
PLAYGROUND_TOKEN=change-me-playground-token
PLAYGROUND_TTL_MIN_MINUTES=5
PLAYGROUND_TTL_MAX_MINUTES=60
PLAYGROUND_TTL_DEFAULT_MINUTES=20
PLAYGROUND_MEMORY_MB=256
PLAYGROUND_CPUS=0.5
PLAYGROUND_WORKSPACE_MB=64
PLAYGROUND_RUN_TIMEOUT=8

# First admin — one-shot bootstrap (optional)
# When true and no admin exists, creates the admin at startup and skips the
# setup token. Clear BOOTSTRAP_ALLOW and the password after the first login.
BOOTSTRAP_ALLOW=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FIRST_NAME=Admin
BOOTSTRAP_ADMIN_LAST_NAME=User
